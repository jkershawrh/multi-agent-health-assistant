# Multi-Agent Health Assistant — Environment Configuration

# Ollama model serving
MODEL_ENDPOINT=http://ollama:11434/v1
MODEL_NAME=qwen2.5:1.5b

# Set to true to use demo responses without LLM backend
DEMO_MODE=false

# Service URLs
ORCHESTRATOR_URL=http://localhost:8000
TRIAGE_AGENT_URL=http://localhost:8001
CLINICAL_AGENT_URL=http://localhost:8002
SCHEDULING_AGENT_URL=http://localhost:8003

# Logging
LOG_LEVEL=INFO
